# §17.387 — host-side kernel-OOM event watcher for scaffold-engine.
#
# Counterpart to scripts/scaffold-oom-watcher.service (§17.161, which
# catches container OOMs via docker events). This unit catches HOST-scope
# OOMs via journalctl -kf — kernel-level kills triggered by global
# memory pressure, NOT by per-container mem_limit breaches.
#
# Install:
#   sudo cp scripts/scaffold-host-oom-watcher.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now scaffold-host-oom-watcher
#
# Verify:
#   systemctl status scaffold-host-oom-watcher
#   journalctl -u scaffold-host-oom-watcher -f
#
# Set User= / WorkingDirectory= / ExecStart= to match your deploy: the
# operator user that owns the repo and the absolute path to your
# scaffold-engine checkout. The placeholders below assume a user named
# "youruser" with the repo at /home/youruser/scaffold-engine.

[Unit]
Description=Scaffold Engine host kernel-OOM event watcher
# Single URL; systemd's Documentation= directive rejects free text and
# logs "Invalid URL, ignoring: <token>" on every daemon-reload for
# anything that isn't a parseable URI. Lesson from §17.161.
Documentation=https://github.com/LocketKeyLLC/scaffold-engine/blob/main/OVERVIEW.md
After=docker.service systemd-journald.service
Requires=docker.service systemd-journald.service

[Service]
Type=simple
User=youruser
# `docker` for the `docker exec scaffold-orchestrator` alert emit; no
# `systemd-journal` group needed because `journalctl -k` reads kernel
# messages from /dev/kmsg, which is world-readable for reads.
Group=docker
WorkingDirectory=/home/youruser/scaffold-engine
ExecStart=/usr/bin/python3 /home/youruser/scaffold-engine/scripts/host_oom_watcher.py
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Lock down the unit per systemd-hardening best practices. The watcher
# only needs: docker CLI access (via docker group) + python3 stdlib +
# read access to the repo dir + read access to /dev/kmsg + write access
# to journald.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
