# ============================================================================
# Scaffold Engine — environment variables
# ============================================================================
#
# >> First-time setup? Just run `make bootstrap`. It will generate every
# >> required value, write a clean .env, and finish with `make doctor` to
# >> confirm the stack is healthy. You don't need to read this file unless
# >> you want to override defaults.
#
# Manual setup: copy this file to `.env` and fill REQUIRED values.
# Defaults are encoded in app/config.py and docker-compose.yml — only
# override what you actually need to change.
#
# Health audit:        make doctor          (read-only check of .env + stack)
# Detailed health:     make doctor-explain    (each check + why it matters)
# Discover live config: scaffold config show  (enumerate every Settings field
#                                              with its current value, default,
#                                              and is-default flag)
#
# Categories below:
#   1. REQUIRED       — compose refuses to start without these.
#   2. RECOMMENDED    — set for prod / scripted runs.
#   3. RUNTIME-LIKELY — settings most users tune.
#   4. ADVANCED       — fine-tuning knobs; defaults are sensible.
# ============================================================================

# ─── 1. REQUIRED ───────────────────────────────────────────────────────────

# Orchestrator API key (X-API-Key header on every protected route).
# Generate with: openssl rand -hex 32
# Set to anything non-empty, OR set SCAFFOLD_AUTH_DISABLED=1 (unsafe).
SCAFFOLD_API_KEY=

# Postgres password. Compose refuses to start without it.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Open WebUI session-cookie secret. Rotating this logs everyone out.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Authentication key Open WebUI uses to talk to the pipelines container.
# Anything non-empty. Must match the value OWUI is configured with.
OPENWEBUI_PIPELINES_KEY=

# ─── 2. RECOMMENDED ────────────────────────────────────────────────────────

# When true, .env beats pipelines/*/valves.json for managed string
# fields (api_key, orchestrator_url, ollama_url). Recommended for prod
# and scripted setups so .env is the single source of truth and key
# rotation is one step. Default false preserves the OWUI valve-UI
# workflow where saving via the UI persists into valves.json.
SCAFFOLD_VALVES_ENV_OVERRIDE=true

# ─── 3. RUNTIME-LIKELY ─────────────────────────────────────────────────────

# Disable orchestrator auth entirely. Only safe for local dev with no
# external network exposure. Production: leave 0.
SCAFFOLD_AUTH_DISABLED=0

# Postgres user. Matches the compose default — change only if you know
# what you're doing.
POSTGRES_USER=scaffold

# GitHub Personal Access Token for `/research github:owner/repo`.
# Anonymous: 60 req/h shared. With token: 5000 req/h per user. Token
# only needs `public_repo` scope for public repos.
GITHUB_TOKEN=

# Logging level: debug | info | warning | error.
LOG_LEVEL=info

# Apply pending DB migrations at orchestrator startup. Set false to
# pin the schema during ops work and run migrations manually via
# `make migrate`.
SCAFFOLD_RUN_MIGRATIONS_ON_STARTUP=true

# Pre-load the CrossEncoder reranker at boot. Eliminates the ~13s
# cold-load on the first /research or /execute call. Costs ~250 MB
# of RAM at idle — turn off if memory-constrained.
SCAFFOLD_PREWARM_RERANKER=true

# Run a stale-job cleanup sweep at startup (recovers crashed runs by
# resetting orphaned 'running' nodes). Sprint X.25 made this default-on
# inside the orchestrator (closes the 30-min restart-mid-DAG dead
# window); set false to opt out.
CLEANUP_ON_STARTUP=true

# Emit logs as JSON instead of human-readable text. JSON is correct
# for log aggregators (ELK, Loki); human is easier to tail manually.
LOG_JSON_FORMAT=true

# Append logs to this file in addition to stdout. Empty disables.
# Dev override (docker-compose.dev.yml) sets LOG_FILE="" because
# /var/log/scaffold is owned by the prod scaffold user (UID 10001)
# and dev runs as 1000.
LOG_FILE=/var/log/scaffold/app.jsonl

# ─── 4. ADVANCED — model overrides ─────────────────────────────────────────
# Defaults match the documented Ollama-based stack. Override per role
# only when wiring different models. `model_embedder_pipeline` and
# `model_reranker` are config-locked (per-request override is rejected;
# embedder dim is locked at 512 to match the Milvus collection).

# MODEL_GENERAL=qwen3-vl:235b-instruct-cloud
# MODEL_VERIFIER=qwen2.5:7b
# MODEL_CODER=qwen2.5-coder:7b
# MODEL_ROUTER=qwen3:4b
# MODEL_FALLBACK=qwen3.5:latest
# MODEL_CLOUD_HEAVY=qwen3-vl:235b-instruct-cloud
# MODEL_CLOUD_ALT=qwen3.5:397b-cloud
# MODEL_EMBEDDER_PIPELINE=qwen3-embedding:8b
# MODEL_EMBEDDER_ID=qwen3-embedding-8b-mrl512   # canonical embedder identifier
# MODEL_RERANKER=tomaarsen/Qwen3-Reranker-0.6B-seq-cls

# Ideation phase model role: which ROLE_FIELDS entry drives
# analyze/distill/compile. "model_router" = local 4b (slow on CPU);
# "model_general" = cloud 235b (faster, network required).
# IDEATION_MODEL_ROLE=model_general

# ─── 4. ADVANCED — per-role provider routing ──────────────────────────────
# Each role's backend is chosen by MODEL_<ROLE>_PROVIDER. Default "ollama"
# preserves the all-local stack. Switch any role to "openai" to route it
# through OPENAI_BASE_URL (api.openai.com or any OpenAI-compatible endpoint
# like vLLM / LocalAI / Ollama-OpenAI-mode). Reranker is config-locked and
# stays out of the provider system.

# MODEL_GENERAL_PROVIDER=ollama          # ollama | openai
# MODEL_VERIFIER_PROVIDER=ollama
# MODEL_CODER_PROVIDER=ollama
# MODEL_ROUTER_PROVIDER=ollama
# MODEL_FALLBACK_PROVIDER=ollama
# MODEL_CLOUD_HEAVY_PROVIDER=ollama
# MODEL_CLOUD_ALT_PROVIDER=ollama
# MODEL_EMBEDDER_PIPELINE_PROVIDER=ollama

# OpenAI-compatible provider — required only if any MODEL_*_PROVIDER=openai.
# OPENAI_BASE_URL points at api.openai.com by default; override for vLLM /
# LocalAI / Ollama OpenAI-mode / etc.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=600
# OPENAI_ORGANIZATION=

# ─── 4. ADVANCED — infrastructure ──────────────────────────────────────────
# Override only when running services on different hosts.

# DATABASE_URL=postgresql+asyncpg://scaffold:<password>@scaffold-postgres:5432/scaffold_engine
# OLLAMA_BASE_URL=http://172.18.0.1:11434
# MILVUS_URI=http://milvus-standalone:19530
# SEARXNG_URL=http://searxng:8080
# REDIS_URL=redis://scaffold-redis:6379/0

# ─── 4. ADVANCED — reranker (CPU-tuned) ────────────────────────────────────
# Bounded ranges and defaults are enforced in app/config.py.

# RERANK_MAX_CANDIDATES=32           # bound on docs scored per call
# RERANK_DOC_TRUNCATE=2000           # max chars per doc into the model
# RERANK_WARN_MS=30000               # log a warning if a single rerank exceeds this
# RERANK_ERROR_MS=120000             # treat as failure if exceeded

# Reranker prompt template. Multi-line strings — override only if you've
# swapped the reranker model and the new one expects a different format.
# Defaults work for Qwen3-Reranker; literal defaults live in app/config.py.
# RERANKER_PROMPT_SYSTEM=
# RERANKER_PROMPT_SUFFIX=
# RERANKER_DEFAULT_INSTRUCTION=

# ─── 4. ADVANCED — research agent caps ─────────────────────────────────────

# RESEARCH_MAX_ITERATIONS=3          # depth=deep is forced down to this ceiling
# RESEARCH_MAX_QUERIES=8             # SearXNG queries per iteration
# RESEARCH_MAX_URLS_PER_ITERATION=20 # pages fetched per iteration
# RESEARCH_SEARXNG_DELAY=1.5         # politeness delay between SearXNG calls (s)
# RESEARCH_CHUNK_SIZE=1500           # tokens per ingested chunk
# RESEARCH_TIMEOUT=3600              # hard cap on a single /research call (s)

# Fetch tunables — bounds on what the research agent will pull and
# concurrency limits to keep CPU / network sane.
# RESEARCH_MAX_URL_BYTES=5242880     # 5 MiB per HTML page
# RESEARCH_MAX_PDF_BYTES=20971520    # 20 MiB per PDF
# RESEARCH_FETCH_CONCURRENCY=5       # parallel page fetches per iteration
# RESEARCH_FETCH_TIMEOUT=15          # per-fetch timeout (s)
# RESEARCH_URL_FETCH_TIMEOUT=30      # /research <url> single-page timeout (s)
# RESEARCH_HEARTBEAT_INTERVAL=8      # SSE heartbeat cadence (s)
# RESEARCH_MAX_ENTRY_CHARS=8000      # cap per ingested entry

# Default Milvus partition domain for unclassified topics.
# DEFAULT_DOMAIN=eng

# Topic ID → Milvus partition domain map. Dict-typed setting; env-override
# accepts JSON ('{"1":"llm","2":"rag",...}'). Default lives in
# app/config.py::topic_to_domain — override is rarely needed.
# TOPIC_TO_DOMAIN={"1":"llm","2":"rag","3":"eng","4":"eng","5":"eng","6":"eng"}

# ─── 4. ADVANCED — ideation caps ───────────────────────────────────────────

# IDEATION_MAX_QUERIES=5
# IDEATION_MAX_DISTILL_RESULTS=15

# ─── 4. ADVANCED — scheduler ───────────────────────────────────────────────

# SCHEDULER_ENABLED=true
# SCHEDULER_TIMEZONE=UTC
# SCHEDULER_JOB_TIMEOUT=3600
# SCHEDULER_MISFIRE_GRACE_TIME=300
# SCHEDULER_SHUTDOWN_TIMEOUT=30
# SCHEDULER_JOBSTORE_URL=             # default: derived from DATABASE_URL via sync_database_url

# ─── 4. ADVANCED — stale-job reapers ───────────────────────────────────────
# Periodic sweeps that fail / cancel stuck jobs and orphaned nodes.

# STALE_THRESHOLD_MINUTES=30          # 'running' job → 'failed' after this
# PLANNING_STALE_MINUTES=60           # 'planning' job → 'cancelled' after this
# LONG_PHASE_STALE_MINUTES=45         # any non-terminal long phase → 'failed'
# AWAITING_CONFIRMATION_STALE_MINUTES=4320  # 72h; awaiting → cancelled
# NODE_ORPHAN_THRESHOLD_MINUTES=30    # 'running' dag_node reset to 'pending'
# CLEANUP_INTERVAL_SECONDS=900        # 15 min between sweeps

# Assist Mode reaper — assist_session inactivity threshold (days).
# Default 7d allows for legitimate multi-day manual implementation.
# ASSIST_IDLE_THRESHOLD_DAYS=7

# ─── 4. ADVANCED — RAG / Milvus ────────────────────────────────────────────

# MILVUS_NUM_PARTITIONS=64           # partition-key fan-out
# EMBEDDING_DIM=512                  # locked: must match Milvus collection
# EMBEDDING_BATCH_SIZE=32
# SEMANTIC_DEDUP_THRESHOLD=0.95      # cosine ≥ this → reject as dup
# VERSION_CHAIN_THRESHOLD=0.90       # cosine in [0.90, 0.95) → version (supersede)
# EMBEDDING_CACHE_MEMORY_SIZE=10000  # L1 LRU entries
# EMBEDDING_CACHE_TTL_S=2592000      # L2 (Redis) TTL = 30d

# ─── 4. ADVANCED — execution agent tuning ──────────────────────────────────

# MAX_RETRIES=3                      # per node before marking failed
# CLOUD_TIMEOUT=3600
# LOCAL_TIMEOUT=1800
# VERIFY_TIMEOUT_SECONDS=120
# NODE_TIMEOUT_SECONDS=600           # individual node execution cap
# MAX_UPSTREAM_CHARS=8000            # how much upstream output to feed each node
# RAG_COSINE_FLOOR=0.3               # results below this are dropped before rerank
# VERIFIER_TOP_K=5                   # docs the verifier sees per node
# EXECUTION_GLOBAL_RETRY_CAP=20      # circuit-breaker on per-job retry total

# Sprint X.24 — process-wide concurrency cap on /execute/all.
# Default 1 keeps the single-user invariant strict; raise once the
# SQLAlchemy pool (pool_size=5, max_overflow=10) is sized to match.
# EXECUTION_GLOBAL_CONCURRENCY=1
# EXECUTION_QUEUE_TIMEOUT_SECONDS=1800  # 0 = wait forever

# SSE keepalive cadence on /execute/all and /research streams.
# SSE_KEEPALIVE_SECONDS=15.0

# ─── 4. ADVANCED — compile / synthesis (W.2 / W.7) ────────────────────────
# Compiled-output assembly + optional LLM synthesis pass.

# COMPILE_OUTPUT_GATE_CHARS=50000    # cap on the SSE-transport payload
# COMPILE_OUTPUT_MIN_CHUNK=200       # per-node minimum in fallback strategy
# COMPILE_OUTPUT_MAX_CHARS=100000    # cap on stored compiled_output

# Sprint W.7 — opt-in LLM rewrite of the heuristic compile output into
# a coherent narrative. Default OFF (existing behavior). Per-job override
# via PATCH /jobs/{id}/synthesis (X.6); per-call response carries the
# `synthesized` flag so callers can render banners.
# COMPILE_SYNTHESIS_ENABLED=false
# COMPILE_SYNTHESIS_MAX_TOKENS=4096

# ─── 4. ADVANCED — DAG validator (W.3) ─────────────────────────────────────
# After the LLM emits a DAG, a second-pass validator LLM checks each
# task's tool selection. On issues, the generator is re-prompted with
# strict corrections, up to N retries.

# DAG_VALIDATOR_ENABLED=true
# DAG_VALIDATOR_MAX_RETRIES=2
# DAG_VALIDATOR_MAX_TOKENS=1024

# ─── 4. ADVANCED — Assist Mode (W.5) ───────────────────────────────────────
# When policy='selective' fires, the LLM rewrites prompt_template for
# affected downstream nodes. Fail-open: any LLM/parse failure falls
# back to legacy reset-only behavior.

# ASSIST_REPLAN_REGEN_ENABLED=true
# ASSIST_REPLAN_REGEN_MAX_TOKENS=2048

# ─── 4. ADVANCED — GitHub ingestion ────────────────────────────────────────

# GITHUB_MAX_FILES=50
# GITHUB_BLOB_CONCURRENCY=8
# GITHUB_TIMEOUT=30
# GITHUB_API_BASE=https://api.github.com

# ─── 4. ADVANCED — OpenAPI ingestion ───────────────────────────────────────

# OPENAPI_MAX_ENDPOINTS=200
# OPENAPI_MAX_PARAMS_PER_ENDPOINT=50
# OPENAPI_TIMEOUT=30

# ─── 4. ADVANCED — ground-truths GitHub destination ────────────────────────
# `/gt push_to_github` writes to this repo.

# GT_GITHUB_OWNER=LocketKeyLLC
# GT_GITHUB_REPO=smokieRAGs
# GT_GITHUB_BRANCH=main
# GT_STATS_SCAN_LIMIT=16384          # cap on rows scanned for /gt/stats

# ─── 4. ADVANCED — prompt + chain hygiene ──────────────────────────────────

# Cap on persisted prompt length (chars). Pipeline-side pre-check
# matches via pipelines/prompt_inspector.py _MAX_PROMPT_CHARS.
# PROMPT_MAX_CHARS=16384

# ─── 4. ADVANCED — web UI loopback (Sprint J.2) ────────────────────────────
# Native single-page web UI (app/web/) calls the orchestrator over HTTP
# loopback so the SDK gets dogfooded as the second consumer after CLI.
# Override only when the orchestrator runs on a non-default port or
# behind a proxy.

# WEB_LOOPBACK_URL=http://localhost:8000
# WEB_LOOPBACK_TIMEOUT=30            # read-path timeout
# WEB_LOOPBACK_LONG_TIMEOUT=1800     # ideate / confirm long-call timeout

# ─── 4. ADVANCED — observability: /metrics + alerts (Sprint X.26) ─────────
# Prometheus scrape target + alert sinks. /metrics is unauthenticated
# (matches Prometheus convention; emits no PII). Alerts can sink to:
# stdlib logger (always), DB (alert_db_enabled), file (alert_file_path).

# METRICS_ENABLED=true
# METRICS_PATH=/metrics

# ALERT_FILE_PATH=                   # empty disables file sink; e.g. /var/log/scaffold/alerts.jsonl
# ALERT_DB_ENABLED=true              # writes to system_alerts table
# ALERT_COOLDOWN_SECONDS=3600        # dedup-key suppression window (1h)

# Push thresholds — periodic scan of llm_call_logs + error_logs.
# ALERT_EVAL_ENABLED=true
# ALERT_EVAL_INTERVAL_SECONDS=300    # 5 min between evaluations
# ALERT_EVAL_WINDOW_MINUTES=60       # rolling lookback per evaluation

# ALERT_UNRESOLVED_ERRORS_THRESHOLD=1     # ≥ N unresolved → oncall.errors_unresolved
# ALERT_COST_WINDOW_USD_THRESHOLD=5.0     # > $N spend → cost.window_exceeded
# ALERT_P95_LATENCY_MS_THRESHOLD=120000   # any model p95 > this → latency.p95_exceeded

# ─── 4. ADVANCED — calibration cron watchdog (Sprint X.26) ────────────────
# Quarterly calibration cron fires Jan/Apr/Jul/Oct 1st @ 08:00 UTC.
# The watchdog catches the case the cron itself didn't run (laptop
# asleep, crontab nuked) and pages once per missed quarter.

# CALIBRATION_WATCHDOG_ENABLED=true
# CALIBRATION_WATCHDOG_INTERVAL_SECONDS=900  # 15 min sweep cadence
# CALIBRATION_GRACE_MINUTES=120              # tolerate this long after fire time

# ─── 4. ADVANCED — OpenTelemetry (Sprint X.26, opt-in) ────────────────────
# Strictly opt-in. No-op unless OTEL_ENABLED=true AND OTEL_OTLP_ENDPOINT
# is set. FastAPI + httpx + asyncpg auto-instrumented when init succeeds.
# /health and /metrics are excluded from the trace stream.

# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=scaffold-engine
# OTEL_OTLP_ENDPOINT=                 # http://otel-collector:4318/v1/traces
