# ============================================================================
# Scaffold Engine — environment variables
# ============================================================================
# Copy this file to `.env` and fill in the REQUIRED values. Defaults are
# already encoded in app/config.py and docker-compose.yml; only override
# what you actually need to change.
#
# Three categories:
#   1. REQUIRED       — compose refuses to start without these.
#   2. RUNTIME-LIKELY — settings you'll probably want to tune locally.
#   3. ADVANCED       — fine-tuning knobs; defaults are sensible.
# ============================================================================

# ---------- 1. REQUIRED ----------

# API key for orchestrator endpoints. Generate with: openssl rand -hex 32
# Set to anything non-empty, OR set SCAFFOLD_AUTH_DISABLED=1 below.
SCAFFOLD_API_KEY=

# PostgreSQL password (compose refuses to start without it).
POSTGRES_PASSWORD=

# Open WebUI session cookie key. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Open WebUI Pipelines authentication key. Anything non-empty.
OPENWEBUI_PIPELINES_KEY=

# ---------- 2. RUNTIME-LIKELY ----------

# Disable orchestrator auth entirely. Only safe for local dev with no key set.
SCAFFOLD_AUTH_DISABLED=0

# When true, .env wins over pipelines/*/valves.json for managed string
# fields (api_key, orchestrator_url, ollama_url). Recommended: true for
# prod / scripted setups so .env is the single source of truth and key
# rotation is one step. Default: false (preserves OWUI valve-UI workflow
# where saving via the UI persists into valves.json and beats env).
SCAFFOLD_VALVES_ENV_OVERRIDE=true

# Postgres user (matches docker-compose default).
POSTGRES_USER=scaffold

# GitHub token for /research github:owner/repo (raises rate limit 60 -> 5000/h).
GITHUB_TOKEN=

# Logging level: debug, info, warning, error.
LOG_LEVEL=info

# Run migrations automatically at orchestrator startup.
SCAFFOLD_RUN_MIGRATIONS_ON_STARTUP=true

# Pre-load CrossEncoder reranker at startup (eliminates 13.6s cold-load on
# first /research or /execute call).
SCAFFOLD_PREWARM_RERANKER=true

# Run a stale-job cleanup sweep at startup (recovers crashed runs).
CLEANUP_ON_STARTUP=false

# Emit logs as JSON instead of human-readable.
LOG_JSON_FORMAT=true

# File path for log output (in addition to stdout). Empty disables.
LOG_FILE=/var/log/scaffold/app.jsonl

# ---------- 3. ADVANCED — model overrides ----------
# All defaults match the documented model stack. Override only when wiring
# new models. Roles `model_embedder_pipeline` and `model_reranker` are
# singleton-locked at config level (per-request override is rejected).

# MODEL_GENERAL=qwen3-vl:235b-instruct-cloud
# MODEL_VERIFIER=qwen2.5:7b
# MODEL_CODER=qwen2.5-coder:7b
# MODEL_ROUTER=qwen3:4b
# MODEL_FALLBACK=qwen3.5:latest
# MODEL_CLOUD_ALT=qwen3.5:397b-cloud
# MODEL_EMBEDDER_PIPELINE=qwen3-embedding:8b
# MODEL_RERANKER=tomaarsen/Qwen3-Reranker-0.6B-seq-cls

# ---------- 3. ADVANCED — infrastructure ----------

# Override these only if running services on different hosts.
# DATABASE_URL=postgresql+asyncpg://scaffold:<password>@scaffold-postgres:5432/scaffold_engine
# OLLAMA_BASE_URL=http://172.18.0.1:11434
# MILVUS_URI=http://milvus-standalone:19530
# SEARXNG_URL=http://searxng:8080
# REDIS_URL=redis://scaffold-redis:6379/0

# ---------- 3. ADVANCED — tunables ----------
# Bounded ranges and defaults are enforced in app/config.py.

# Reranker performance thresholds (CPU-tuned).
# RERANK_MAX_CANDIDATES=32
# RERANK_DOC_TRUNCATE=2000
# RERANK_WARN_MS=30000
# RERANK_ERROR_MS=120000

# Research agent caps.
# RESEARCH_MAX_ITERATIONS=3
# RESEARCH_MAX_QUERIES=8
# RESEARCH_MAX_URLS_PER_ITERATION=20
# RESEARCH_SEARXNG_DELAY=1.5
# RESEARCH_CHUNK_SIZE=1500
# RESEARCH_TIMEOUT=3600

# Ideation caps.
# IDEATION_MAX_QUERIES=5
# IDEATION_MAX_DISTILL_RESULTS=15
# IDEATION_MODEL_ROLE=model_general

# Scheduler.
# SCHEDULER_ENABLED=true
# SCHEDULER_TIMEZONE=UTC
# SCHEDULER_JOB_TIMEOUT=3600
# SCHEDULER_MISFIRE_GRACE_TIME=300
# SCHEDULER_SHUTDOWN_TIMEOUT=30
# NODE_ORPHAN_THRESHOLD_MINUTES=60

# RAG / Milvus.
# MILVUS_NUM_PARTITIONS=64
# EMBEDDING_DIM=512
# EMBEDDING_BATCH_SIZE=32
# SEMANTIC_DEDUP_THRESHOLD=0.95
# VERSION_CHAIN_THRESHOLD=0.90
# EMBEDDING_CACHE_MEMORY_SIZE=10000
# EMBEDDING_CACHE_TTL_S=2592000

# Execution.
# MAX_RETRIES=3
# CLOUD_TIMEOUT=3600
# LOCAL_TIMEOUT=1800
# VERIFY_TIMEOUT_SECONDS=120

# GitHub ingestion.
# GITHUB_MAX_FILES=50
# GITHUB_BLOB_CONCURRENCY=8
# GITHUB_TIMEOUT=30

# OpenAPI ingestion.
# OPENAPI_MAX_ENDPOINTS=200
# OPENAPI_MAX_PARAMS_PER_ENDPOINT=50
# OPENAPI_TIMEOUT=30

# Ground-truths GitHub destination (for /gt push_to_github).
# GT_GITHUB_OWNER=LocketKeyLLC
# GT_GITHUB_REPO=smokieRAGs
