#!/bin/bash
# §17.1409 — pct in rehearsal: the guest IS this sandbox.
echo "pct $*" >> /rehearsal/log
case "$1" in
  # host and guest share this filesystem: a push to the same path is already there
  push) [ "$(readlink -f "$3")" = "$(readlink -f "$4" 2>/dev/null)" ] && exit 0
        mkdir -p "$(dirname "$4")"; exec cp "$3" "$4";;
  exec) shift 2; [ "$1" = "--" ] && shift; exec "$@";;
  status) echo "status: running";;
  start|stop|set) exit 0;;
  *) exit 0;;
esac
