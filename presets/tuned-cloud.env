# §17.1002 — the measured cloud picks, tracked so a rebuild can restore them.
#
# `.env` is gitignored and §17.819 keeps the CODE defaults local-safe on purpose:
# a fresh install with no cloud access must still work. That left the tuned
# picks living only on the operator's box — §17.994 wrote them into
# `.env.example` as comments so they were at least recoverable, and §17.995 then
# found a THIRD stale comment, because a record nobody applies is a record
# nobody checks.
#
# This file is applied, not read: `make apply-preset PRESET=tuned-cloud`.
# Every value here was measured on the role's own gate — see app/config.py's
# `tuned cloud pick` comments for the numbers, which a test keeps in sync with
# this file.
#
# Requires an Ollama Cloud account. For a local-only box, do NOT apply this —
# the §17.819 defaults are the right answer there.

# routing 24/24 @0.55s (§17.993)
MODEL_ROUTER=gemma4:cloud
# extraction 12/12; 9-10 facts/job e2e (§17.999)
MODEL_GENERAL=deepseek-v4-pro:cloud
# triage 10/10 @1.03s vs the qwen3.5 incumbent 6/10 @55.9s (§17.997)
MODEL_TRIAGE=gemma4:cloud
# hardened verifier gate 26/26 (§17.998); diversified off gemma4 (§17.999)
MODEL_VERIFIER=glm-5.3-flash:cloud
# §17.1624 — deepseek-v4-flash AND its runner-up glm-5.1 were RETIRED 2026-09-25 (410).
# research_extract contract 2026-10-16 (repeat 2): deepseek-v4-pro 8/8 @3.08s, glm-5.3 8/8 @5.62s,
# kimi-k3 8/8 @7.99s, glm-5.3-flash 6/8, gemma4 6/8.
MODEL_RESEARCH_EXTRACT=deepseek-v4-pro:cloud
# codegen 16/16 (§17.498/575)
MODEL_CODER=kimi-k2.7-code:cloud
# §17.1624 — qwen3.5:397b-cloud was RETIRED by Ollama Cloud 2026-09-25 (410 Gone);
# deepseek-v4-pro:cloud was the engine's own role-learning runner-up for both; on the codegen
# proxy gate (2026-10-16, repeat 2) it, kimi-k2.7-code, glm-5.3 and kimi-k3 all scored 16/16
# (3.29 / 2.52 / 5.75 / 5.77 s), so kimi-k2.7-code is the declared candidate.
MODEL_CLOUD_HEAVY=deepseek-v4-pro:cloud
MODEL_CLOUD_ALT=deepseek-v4-pro:cloud
# LOCAL on purpose — fallback must differ from primary or it adds no
# failure-mode diversity (§17.819).
MODEL_FALLBACK=qwen3.5:latest

# §17.994 — runner-up on each role's OWN gate, never a guess.
MODEL_ROLE_LEARNING_CANDIDATES={"model_router":["deepseek-v4-pro:cloud"],"model_general":["glm-5.3-flash:cloud"],"model_research_extract":["glm-5.3:cloud"],"model_verifier":["gemma4:cloud"],"model_coder":["deepseek-v4-pro:cloud"],"model_cloud_heavy":["kimi-k2.7-code:cloud"],"model_cloud_alt":["kimi-k2.7-code:cloud"],"model_triage":["glm-5.3-flash:cloud"]}

# §17.991 — operator-owned config dir: a bind mount does not traverse the
# parent, so this needs to be READABLE by uid 977, not owned by it. Keep the
# `duckduckgo: disabled` block in its settings.yml.
SEARXNG_CONFIG_DIR=/home/aedefruscio/searxng-config
