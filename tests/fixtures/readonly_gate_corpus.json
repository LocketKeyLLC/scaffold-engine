{
  "_": "\u00a717.1173 \u2014 the shared read-only-gate corpus. Asserted from BOTH app/modules/assist_state_check.read_only_command AND scripts/local_runner_mcp.read_only, so the two gates cannot drift. SANITIZED: shapes are taken from a 318-command replay of real probe history; values are RFC 5737 documentation addresses and generic names, because this repo is public.",
  "allow": [
    "cat /etc/hosts",
    "cat /etc/network/interfaces 2>/dev/null",
    "grep -n 'dns-nameservers' /etc/network/interfaces",
    "grep -A8 'iface vmbr0' /etc/network/interfaces",
    "ls -la /etc/apt",
    "ls -l /opt/app; pgrep -af app",
    "head -5 /var/log/syslog",
    "getent passwd someuser",
    "id someuser",
    "hostname; uname -a",
    "journalctl -u docker -n 50 --no-pager",
    "systemctl status caddy --no-pager",
    "systemctl is-enabled app.service; systemctl is-active app.service",
    "ip -br addr",
    "ip -4 addr show vmbr0",
    "ip neigh show 192.0.2.26",
    "bridge link",
    "ss -tlnp",
    "ss -lunp | grep 8211",
    "lspci -nn | grep -i '02:00.0'; cat /proc/cmdline; lsmod | grep -i nvidia",
    "nvidia-smi",
    "lvs --noheadings -o lv_name,vg_name | grep 'vm-100-disk-0'",
    "zpool list",
    "zpool status -v",
    "zfs list -o name,used,avail",
    "pct config 101 | grep -i nameserver",
    "pct status 101; pct config 101",
    "pct list",
    "pct config 101 | grep -E '^mp0'; pct exec 101 -- sh -c 'mountpoint /media; ls -ld /media'",
    "pct exec 101 -- cat /etc/hostname",
    "pct exec 105 -- bash -c 'dpkg -l app 2>/dev/null | grep -E \"^ii\"; systemctl is-enabled app.service'",
    "pct exec 103 -- sh -c 'command -v curl; dpkg-query -W -f=\"${Version}\" libgdiplus'",
    "pct exec 101 -- find /var/lib/app -maxdepth 2 -iname '*.xml' 2>/dev/null | head",
    "pct exec 111 -- sh -c 'ls /opt/backend && pm2 list'",
    "qm config 110 | grep -E 'net0|hostpci|boot'",
    "qm list",
    "qm status 110",
    "qm config $(qm list | awk 'NR==2{print $1}')",
    "pve-firewall status",
    "pvesh get /nodes/$(hostname)/firewall/rules --output-format json",
    "pvesm status",
    "pveam available",
    "pvecm status",
    "cat /etc/pve/firewall/cluster.fw 2>/dev/null; echo '---HOST---'; cat /etc/pve/firewall/host.fw 2>/dev/null",
    "curl -s -o /dev/null -w '%{http_code}' http://192.0.2.25:3001",
    "for ip in 192.0.2.20:8096 192.0.2.21:9696; do printf '%s ' \"$ip\"; curl -s -o /dev/null -w '%{http_code}\\n' --max-time 5 \"http://$ip\"; done",
    "for ct in 101 102 103; do echo \"== CT $ct ==\"; pct exec $ct -- ss -tlnp 2>/dev/null | awk 'NR>1 {print $4}'; done",
    "ssh user@192.0.2.127 'hostname; uname -a; grep PRETTY_NAME /etc/os-release'",
    "ssh root@192.0.2.20 nvidia-smi",
    "tailscale status",
    "tailscale ip -4",
    "caddy validate --config /etc/caddy/Caddyfile",
    "nginx -t",
    "sshd -t",
    "nc -z -w 2 192.0.2.127 22 2>&1; echo rc=$?",
    "ping -c1 -W1 192.0.2.1 >/dev/null 2>&1 && echo up || echo down",
    "dpkg -l | grep '^ii'",
    "dpkg-query -W -f='${Status}' curl",
    "apt list --installed",
    "pip3 show mcp",
    "crontab -l",
    "iptables -S PVEFW-HOST-IN",
    "ufw status verbose",
    "git status",
    "git log --oneline -5",
    "docker ps",
    "docker inspect app",
    "sh -c 'cat /etc/os-release'",
    "bash -lc 'cat /etc/os-release'",
    "sudo cat /etc/pve/firewall/host.fw",
    "timeout 5s qm config 106",
    "grep -E \"a|b\" /etc/hosts",
    "grep -o '<a>' f | head",
    "sed -n '1,5p' /etc/hosts",
    "find /etc -name '*.conf' -maxdepth 2",
    "df -h; free -m; uptime"
  ],
  "refuse": [
    "find /tmp -name x -delete",
    "find / -name '*.log' -exec rm -f {} \\;",
    "find /etc -name x -execdir rm {} +",
    "find / -name x -fls /tmp/out",
    "tar -xf /tmp/evil.tar -C /",
    "rsync -a /tmp/x/ /etc/",
    "rsync --delete -a /tmp/ /etc/",
    "shred -u /etc/shadow",
    "srm /etc/shadow",
    "install -m 777 /bin/sh /tmp/s",
    "install -D /tmp/a /etc/b",
    "xargs rm -rf < /tmp/list",
    "awk 'BEGIN{system(\"rm -rf /tmp/x\")}'",
    "awk '{print > \"/etc/passwd\"}' f",
    "systemd-run --scope rm -rf /x",
    "systemd-nspawn -D /",
    "chroot / /bin/sh",
    "nsenter -t 1 -m rm -rf /x",
    "busybox rm -rf /x",
    "lvremove -y vg/lv",
    "mount -o remount,rw /",
    "git clean -fdx",
    "psql -c 'DROP TABLE jobs'",
    "chsh -s /bin/sh root",
    "unlink /etc/passwd",
    "setfacl -m u:x:rwx /etc",
    "dd if=/dev/zero of=/dev/sda",
    "chattr -i /etc/passwd",
    "setcap cap_net_raw+ep /bin/x",
    "usermod -aG sudo attacker",
    "gpasswd -a x sudo",
    "newusers /tmp/u",
    "mkswap /dev/sdb1",
    "swapoff -a",
    "sysctl -w kernel.panic=1",
    "modprobe -r nvidia",
    "insmod /tmp/x.ko",
    "depmod -a",
    "update-grub",
    "grub-install /dev/sda",
    "efibootmgr -B -b 0001",
    "tee /etc/motd",
    "cpio -i < /tmp/a.cpio",
    "unzip -o /tmp/x.zip -d /",
    "gunzip -f /etc/x.gz",
    "logrotate -f /etc/logrotate.conf",
    "at now",
    "batch",
    "mknod /dev/x c 1 3",
    "losetup -d /dev/loop0",
    "wipefs -a /dev/sdb",
    "blkdiscard /dev/sdb",
    "sgdisk --zap-all /dev/sdb",
    "truncate -s 0 /var/log/syslog",
    "scp /tmp/x root@h:/etc/x",
    "openssl req -x509 -out /etc/ssl/x.pem -newkey rsa",
    "nc -l -p 4444 -e /bin/sh",
    "ncat -l -k -e /bin/bash",
    "nc -l 4444",
    "socat TCP-LISTEN:4444,fork EXEC:/bin/sh",
    "dmesg -C",
    "ss -K dst 192.0.2.4",
    "yq -i '.a=1' /etc/x.yml",
    "nginx",
    "nginx -s reload",
    "nginx -s stop",
    "sshd",
    "httpd -k restart",
    "bash -lc 'rm -rf /'",
    "sudo bash -lc 'rm -rf /etc'",
    "sh -ec 'shutdown -h now'",
    "perl -le 'unlink \"/etc/passwd\"'",
    "python3 -Ic 'import os'",
    "bash /tmp/x.sh",
    "source /tmp/x.sh",
    "bash -s",
    "bash"
  ]
}